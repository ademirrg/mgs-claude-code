		{
			"name": "Health",
			"item": [
				{
					"name": "Health check",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"pm.test('Application is UP', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.status).to.eql('UP');",
									"    pm.expect(body.timestamp).to.be.a('string');",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"health"
							]
						},
						"description": "Public. Returns 200 when UP, 503 when the application or one of its dependencies is down."
					},
					"response": [
						{
							"name": "200 OK",
							"originalRequest": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/health",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"api",
										"health"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"status\": \"UP\",\n    \"timestamp\": \"2026-10-29T18:00:00Z\"\n}"
						}
					]
				}
			]
		},
		{
			"name": "Persons",
			"description": "CRUD on people as ADMIN (uses the collection's `Bearer {{adminToken}}`). Run **Auth > Login as admin** first.",
			"item": [
				{
					"name": "Create person",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Unique email so the collection can be run repeatedly against the same database",
									"pm.collectionVariables.set('personEmail', `alice.${Date.now()}@example.com`);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 201', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.test('Returns the created person', () => {",
									"    pm.expect(body.id).to.be.a('number');",
									"    pm.expect(body.firstName).to.eql('Alice');",
									"    pm.expect(body.email).to.eql(pm.collectionVariables.get('personEmail'));",
									"});",
									"pm.test('Location header points to the person', () => {",
									"    pm.expect(pm.response.headers.get('Location')).to.eql(`/api/persons/${body.id}`);",
									"});",
									"pm.collectionVariables.set('personId', body.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"Alice\",\n    \"lastName\": \"Smith\",\n    \"email\": \"{{personEmail}}\",\n    \"birthDate\": \"1990-05-01\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/persons",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"persons"
							]
						},
						"description": "Requires ADMIN. Saves the new id to `personId`.\n\nRules: `firstName`/`lastName` required (max 100), `email` required, valid and unique (max 255), `birthDate` optional and in the past."
					},
					"response": [
						{
							"name": "201 Created",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"firstName\": \"Alice\",\n    \"lastName\": \"Smith\",\n    \"email\": \"alice@example.com\",\n    \"birthDate\": \"1990-05-01\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/persons",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"api",
										"persons"
									]
								}
							},
							"status": "Created",
							"code": 201,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								},
								{
									"key": "Location",
									"value": "/api/persons/1"
								}
							],
							"body": "{\n    \"id\": 1,\n    \"firstName\": \"Alice\",\n    \"lastName\": \"Smith\",\n    \"email\": \"alice@example.com\",\n    \"birthDate\": \"1990-05-01\"\n}"
						}
					]
				},
