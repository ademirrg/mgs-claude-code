{
	"info": {
		"name": "mgs-claude-code API",
		"description": "Requests for the mgs-claude-code API: JWT login, Person CRUD and health check.\n\nRun the folders in order. **Auth** logs in as `admin` and `user` and stores their tokens in the collection variables `adminToken` and `userToken`. The collection's default auth is `Bearer {{adminToken}}`; requests in **Authorization checks** override it to test 401/403.\n\nSelect the **mgs-claude-code local** environment (or set `baseUrl` and the credential variables yourself).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "adminToken",
			"value": ""
		},
		{
			"key": "userToken",
			"value": ""
		},
		{
			"key": "personId",
			"value": ""
		},
		{
			"key": "personEmail",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Auth",
			"description": "Exchange credentials for JWT access tokens. Public endpoint.",
			"item": [
				{
					"name": "Login as admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('Returns a Bearer token', () => {",
									"    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
									"    pm.expect(body.tokenType).to.eql('Bearer');",
									"    pm.expect(body.expiresIn).to.be.above(0);",
									"});",
									"pm.collectionVariables.set('adminToken', body.accessToken);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{adminUsername}}\",\n    \"password\": \"{{adminPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Logs in with the ADMIN account and saves the token to `adminToken`."
					},
					"response": [
						{
							"name": "200 OK",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/auth/login",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"api",
										"auth",
										"login"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"accessToken\": \"eyJhbGciOiJIUzI1NiJ9...\",\n    \"tokenType\": \"Bearer\",\n    \"expiresIn\": 3600\n}"
						}
					]
				},
				{
					"name": "Login as user",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('Returns a Bearer token', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
									"pm.collectionVariables.set('userToken', body.accessToken);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
